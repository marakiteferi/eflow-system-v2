# Copy this file to server/.env and fill in your own values.

# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eflow

# Secrets (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change_me
APPROVAL_SIGNING_SECRET=change_me_too

# Email (any SMTP provider; Brevo was used in development).
# Without these, OTP codes and reset links are still printed to the server console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@example.com

# Password for the demo accounts created by `npm run db:setup`
DEMO_PASSWORD=demo1234

# Optional
# RUN_BACKGROUND_JOBS=false   # on API servers when a separate `npm run worker` runs the jobs
# TRUST_PROXY=1               # behind a reverse proxy, so rate limits see the real client address
# RATE_LIMIT_LOGIN=10         # failed sign-ins per account and address per 15 minutes
# RATE_LIMIT_CODES=10         # one-time code requests per user per 10 minutes
